<?xml version="1.0"?>
<ruleset name="WeConvert">
    <description>Règles de code pour WeConvert.io Suite.</description>

    <file>weconvert-suite</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_wp_version" value="6.0"/>
    <config name="testVersion" value="8.0-"/>

    <rule ref="WordPress-Extra">
        <!-- Le code existant utilise des noms de fichiers « weconvert-*.php » et des tableaux courts. -->
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="kb"/>
                <element value="weconvert"/>
            </property>
        </properties>
    </rule>
</ruleset>
